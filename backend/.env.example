# Rodando via Docker Compose (recomendado): NÃO precisa deste arquivo — as
# variáveis são injetadas pelo docker-compose.yml a partir do ".env" da raiz
# do projeto. Veja o ".env.example" na raiz.
#
# Este arquivo só é necessário se você rodar o backend fora do Docker
# (ex: "npm run dev" direto, com um MySQL local).

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cotton_db"

JWT_SECRET="troque-por-uma-chave-secreta-forte-min-32-chars"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="12h"

PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

ENCRYPTION_KEY="troque-por-uma-chave-de-32-caracteres"

# SMTP (recuperação de senha por email) — sem SMTP_HOST, só loga no console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cotton Fibra Forte <no-reply@seudominio.com>"
