// This is your Prisma schema file
// Learn more about it: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// ─── ENUMS ───────────────────────────────────────────────────────────────────
enum StatusLiberacao {
  ATIVA
  CONCLUIDA
  CANCELADA
  // Parada temporariamente (motivo obrigatório): sem alertas e fora dos KPIs de risco.
  SUSPENSA
}
enum TipoFardo {
  FARDAO
  FARDINHO
}
// Timeline do veículo (nov/2026), em sequência. Conta como "carregado" a partir de
// MANIFESTADO (ver STATUS_CARREGADO em services/liberacao-status.ts).
enum StatusVeiculo {
  AGUARDANDO_GR
  TRANSITO_CARREGAMENTO
  LOCAL
  MANIFESTADO
  FALTA_AGENDAR
  AGENDADO
  AGUARDANDO_DESCARGA
  FINALIZADO
}
enum StatusSM {
  PENDENTE
  ABERTA
  LIBERADA
  ENCERRADA
}
enum StatusRastreamento {
  // Ainda não informado — padrão de todo veículo novo.
  PENDENTE
  RASTREADOR
  LOCALIZADO
  APLICATIVO
  NAO_RASTREADO
}
enum TipoAcesso {
  EMAIL
  LINK
  API
}
enum TipoAlerta {
  DEADLINE_PROXIMO
  CARGA_ATRASADA
  SALDO_PENDENTE
  STATUS_ALTERADO
  DOCUMENTACAO_PENDENTE
  AGENDAMENTO_NECESSARIO
}
enum StatusAlerta {
  ENVIADO
  FALHOU
  PENDENTE
}
enum PerfilUsuario {
  ADMIN
  OPERADOR
  GESTOR_FILIAL
  VISUALIZADOR
  CLIENTE
  // Gerenciadora de risco: só a tela GR.
  GR
  // Cliente convidado (login próprio): só a tela de posição do cliente dele.
  VISITANTE
}

enum TipoAcessoCliente {
  // Link sem login, válido por 24 h.
  LINK
  // Convite por e-mail para criar login de Visitante (link de cadastro válido por 7 h).
  CONVITE
}
enum AcaoAuditoria {
  INSERT
  UPDATE
  DELETE
}
// ─── TABELAS PRINCIPAIS ───────────────────────────────────────────────────────
model Cliente {
  id         Int      @id @default(autoincrement())
  nome       String   @unique
  cnpj       String   @unique
  email      String?
  contatos   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  liberacoes   Liberacao[]
  usuarios     Usuario[]
  alertasConfig AlertaConfig[]
  acessos      AcessoCliente[]
  @@map("clientes")
}
model Origem {
  id          Int      @id @default(autoincrement())
  nome        String   @unique
  localizacao String
  estado      String
  createdAt   DateTime @default(now()) @map("created_at")
  liberacoes Liberacao[]
  usuarios   Usuario[]
  @@map("origens")
}
model Destino {
  id          Int      @id @default(autoincrement())
  nome        String   @unique
  estado      String
  createdAt   DateTime @default(now()) @map("created_at")
  liberacoes  Liberacao[]
  @@map("destinos")
}
model LocalColeta {
  id          Int      @id @default(autoincrement())
  nome        String   @unique
  cidade      String?
  estado      String?
  createdAt   DateTime @default(now()) @map("created_at")
  liberacoes  Liberacao[]
  @@map("locais_coleta")
}
// Local de entrega da carga — cadastro livre, igual ao local de coleta.
model LocalEntrega {
  id          Int      @id @default(autoincrement())
  nome        String   @unique
  cidade      String?
  estado      String?
  createdAt   DateTime @default(now()) @map("created_at")
  liberacoes  Liberacao[]
  @@map("locais_entrega")
}
model Terminal {
  id                     Int        @id @default(autoincrement())
  nome                   String     @unique
  tipoAcesso             TipoAcesso @map("tipo_acesso")
  linkSistema            String? @map("link_sistema")
  login                  String?
  senha                  String?
  cnpj                   String?
  emailsContato          String? @map("emails_contato")
  instrucoesEspecificas  String? @map("instrucoes_especificas")
  documentosNecessarios  String? @map("documentos_necessarios")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")
  liberacoes    Liberacao[]
  alertasConfig AlertaConfig[]
  @@map("terminais")
}
model ModeloCarreta {
  id                       Int      @id @default(autoincrement())
  nomeDescricao            String   @map("nome_descricao")
  placaVeiculo             String?  @map("placa_veiculo")
  motoristaNome            String? @map("motorista_nome")
  motoristaTelefone        String? @map("motorista_telefone")
  capacidadeMaximaFardos   Int @map("capacidade_maxima_fardos")
  pesoMaximoKg             Int @map("peso_maximo_kg")
  comprimentoM             Float? @map("comprimento_m")
  larguraM                 Float? @map("largura_m")
  alturaM                  Float? @map("altura_m")
  caracteristicasEspeciais String? @map("caracteristicas_especiais")
  observacoes              String?
  ativo                    Boolean  @default(true)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  veiculos Veiculo[]
  @@map("modelo_carretas")
}

model ReferenciaCadastro {
  id        Int      @id @default(autoincrement())
  tipo      String
  valor     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([tipo, valor])
  @@map("referencias_cadastro")
}
model Transportadora {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  cnpj      String   @unique
  telefone  String?
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  veiculos Veiculo[]
  @@map("transportadoras")
}
model Liberacao {
  id             Int              @id @default(autoincrement())
  instrucao      String           @unique
  dataLiberacao  DateTime @map("data_liberacao")
  dataColeta     DateTime @map("data_coleta")
  clienteId      Int @map("cliente_id")
  origemId       Int @map("origem_id")
  destinoId      Int @map("destino_id")
  terminalId     Int @map("terminal_id")
  localColetaId  Int @map("local_coleta_id")
  // Opcional: liberações anteriores ao campo não têm local de entrega.
  localEntregaId Int? @map("local_entrega_id")
  // Campos diretos: a Liberação é a fonte de cadastro operacional.
  clienteNome    String? @map("cliente_nome")
  filialNome     String? @map("filial_nome")
  destinoNome    String? @map("destino_nome")
  origemNome     String? @map("origem_nome")
  localColetaNome String? @map("local_coleta_nome")
  localEntregaNome String? @map("local_entrega_nome")
  // R$ por tonelada. Margem (%) = (freteEmpresa - freteMotorista) / freteEmpresa × 100.
  freteEmpresa   Float @map("frete_empresa")
  // R$ por tonelada combinado com o motorista — pré-preenche o frete de cada viagem.
  freteMotorista Float? @map("frete_motorista")
  totalFardos    Int @map("total_fardos")
  tipoFardo      TipoFardo        @default(FARDAO) @map("tipo_fardo")
  deadline       DateTime
  // Peso total da instrução, em toneladas. Obrigatório em instruções novas;
  // as antigas ficam sem até alguém editar. Peso médio do fardo = pesoTotal ÷ totalFardos.
  pesoTotal      Float? @map("peso_total")
  // Cache do carregado real: soma dos fardos dos veículos ativos a partir de
  // MANIFESTADO (recalculado a cada alteração de veículo). Nunca digitado.
  carregado      Int              @default(0)
  observacao     String?
  status         StatusLiberacao  @default(ATIVA)
  // Concluída pelo ADMIN com fardos ainda pendentes (todos os veículos
  // finalizados, mas saldo > 0) — aparece em amarelo na lista de concluídas.
  fechamentoManual          Boolean   @default(false) @map("fechamento_manual")
  fardosPendentesFechamento Int?      @map("fardos_pendentes_fechamento")
  motivoFechamento          String?   @map("motivo_fechamento")
  fechamentoManualPor       String?   @map("fechamento_manual_por")
  fechamentoManualEm        DateTime? @map("fechamento_manual_em")
  // O que faltava no checklist de fechamento quando o ADMIN finalizou mesmo assim (uma pendência por linha).
  pendenciasFechamento      String?   @map("pendencias_fechamento")
  // Suspensão (status SUSPENSA).
  motivoSuspensao           String?   @map("motivo_suspensao")
  suspensaPor               String?   @map("suspensa_por")
  suspensaEm                DateTime? @map("suspensa_em")
  // Quando passou a CONCLUIDA (automática ou manual) — base dos relatórios por período.
  concluidaEm               DateTime? @map("concluida_em")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  cliente  Cliente  @relation(fields: [clienteId], references: [id])
  origem   Origem   @relation(fields: [origemId], references: [id])
  destino  Destino  @relation(fields: [destinoId], references: [id])
  terminal Terminal @relation(fields: [terminalId], references: [id])
  localColeta LocalColeta @relation(fields: [localColetaId], references: [id])
  localEntrega LocalEntrega? @relation(fields: [localEntregaId], references: [id])
  veiculos    Veiculo[]
  alertasLog  AlertaLog[]
  @@index([clienteId])
  @@index([deadline])
  @@index([status])
  @@index([concluidaEm])
  @@map("liberacoes")
}
model Veiculo {
  id                 Int           @id @default(autoincrement())
  liberacaoId        Int @map("liberacao_id")
  placa              String
  modeloCarretaId    Int @map("modelo_carreta_id")
  // R$ por tonelada desta viagem.
  freteMotorista     Float @map("frete_motorista")
  qtdFardos          Int @map("qtd_fardos")
  // Peso real carregado nesta viagem, em toneladas (NF/balança). A tela recebe em kg e converte.
  pesoCarregado      Float? @map("peso_carregado")
  motoristaNome      String @map("motorista_nome")
  motoristaTelefone  String @map("motorista_telefone")
  motoristaCpf       String? @map("motorista_cpf")
  motoristaEmail     String? @map("motorista_email")
  transportadoraId   Int? @map("transportadora_id")
  status             StatusVeiculo @default(AGUARDANDO_GR)
  statusSm           StatusSM      @default(PENDENTE) @map("status_sm")
  statusRastreamento StatusRastreamento @default(PENDENTE) @map("status_rastreamento")
  // Isca: null = não respondido; false = "Não possui isca"; true = possui (numeroIsca).
  possuiIsca         Boolean?      @map("possui_isca")
  numeroIsca         String?       @map("numero_isca")
  // Forma de pagamento combinada — só informativa (conferência no ERP). Opções em
  // referencias_cadastro, tipo "formasPagamento".
  formaPagamento     String?       @map("forma_pagamento")
  // Excluir veículo = inativar (não apaga). Inativo fica bloqueado e fora de todas as somas.
  ativo              Boolean       @default(true)
  motivoInativacao   String?       @map("motivo_inativacao")
  inativadoPor       String?       @map("inativado_por")
  inativadoEm        DateTime?     @map("inativado_em")
  motivoReativacao   String?       @map("motivo_reativacao")
  // Informe (ordem do caminhão p/ WhatsApp): dimensões e quem captou o motorista.
  comprimento        String?       // texto livre, ex.: 12.35X12.35
  altura             Float?        // metros
  captacao           String?       // nome livre de quem captou o motorista
  // Usuário que lançou o veículo (linha CADASTRO do Informe).
  cadastradoPor      String?       @map("cadastrado_por")
  dataAgendamento    DateTime? @map("data_agendamento")
  dataCarregamento   DateTime? @map("data_carregamento")
  dataDescarga       DateTime? @map("data_descarga")
  // Quando o status passou a FINALIZADO — base dos relatórios por período.
  finalizadoEm       DateTime? @map("finalizado_em")
  observacao         String?
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  liberacao      Liberacao       @relation(fields: [liberacaoId], references: [id], onDelete: Cascade)
  modeloCarreta  ModeloCarreta   @relation(fields: [modeloCarretaId], references: [id])
  transportadora Transportadora? @relation(fields: [transportadoraId], references: [id])
  alertasLog AlertaLog[]
  @@index([liberacaoId])
  @@index([placa])
  @@index([status])
  @@index([finalizadoEm])
  @@index([ativo])
  @@map("veiculos")
}
// Parâmetros do sistema ajustáveis na tela (Revisão de Dados › Parâmetros), chave → valor.
model ConfiguracaoSistema {
  id        Int      @id @default(autoincrement())
  chave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("configuracoes_sistema")
}
// Acessos do cliente à tela de posição: link temporário ou convite de Visitante.
// O token cru só existe no link; aqui fica o hash SHA-256.
model AcessoCliente {
  id          Int               @id @default(autoincrement())
  tipo        TipoAcessoCliente
  clienteId   Int               @map("cliente_id")
  tokenHash   String            @unique @map("token_hash")
  email       String?
  expiraEm    DateTime          @map("expira_em")
  geradoPorId Int               @map("gerado_por_id")
  usadoEm     DateTime?         @map("usado_em")
  // Convite aceito: usuário Visitante criado.
  aceitoEm    DateTime?         @map("aceito_em")
  usuarioId   Int?              @map("usuario_id")
  canceladoEm DateTime?         @map("cancelado_em")
  createdAt   DateTime          @default(now()) @map("created_at")
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  geradoPor Usuario  @relation("AcessoGeradoPor", fields: [geradoPorId], references: [id])
  usuario   Usuario? @relation("AcessoUsuario", fields: [usuarioId], references: [id])
  @@index([clienteId])
  @@map("acessos_cliente")
}

// Retrato diário dos KPIs do Dashboard (comparação "vs. semana passada" e minigráfico).
model KpiDiario {
  id                Int      @id @default(autoincrement())
  dia               DateTime @unique @db.Date
  cargasAtivas      Int      @map("cargas_ativas")
  emRisco           Int      @map("em_risco")
  fardosPendentes   Int      @map("fardos_pendentes")
  taxaCumprimento   Float    @map("taxa_cumprimento")
  updatedAt         DateTime @updatedAt @map("updated_at")
  @@map("kpis_diarios")
}

model Usuario {
  id        Int           @id @default(autoincrement())
  nome      String
  email     String        @unique
  senhaHash String @map("senha_hash")
  telefone  String?
  perfil    PerfilUsuario
  clienteId Int? @map("cliente_id")
  filialId  Int? @map("filial_id")
  ativo     Boolean       @default(true)
  // Preferências de aparência (Minha conta): paleta VERDE/AZUL e modo CLARO/ESCURO (null = do sistema).
  tema      String        @default("AZUL")
  // Estilo visual do painel: CLASSICO / CONTROLE / LAVOURA / EXECUTIVO / SAFRA.
  estilo    String        @default("CLASSICO")
  modo      String?
  lastLogin DateTime? @map("last_login")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  cliente Cliente? @relation(fields: [clienteId], references: [id])
  filial  Origem?  @relation(fields: [filialId], references: [id])
  auditoria AuditoriaLog[]
  resetTokens PasswordResetToken[]
  acessosGerados AcessoCliente[] @relation("AcessoGeradoPor")
  acessosVisitante AcessoCliente[] @relation("AcessoUsuario")
  @@index([email])
  @@map("usuarios")
}
model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  // hash SHA-256 do token — o valor cru só existe no link enviado por email.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@index([usuarioId])
  @@map("password_reset_tokens")
}
model AlertaConfig {
  id            Int        @id @default(autoincrement())
  clienteId     Int? @map("cliente_id")
  terminalId    Int? @map("terminal_id")
  tipoAlerta    TipoAlerta @map("tipo_alerta")
  diasAntes     Int @map("dias_antes")
  canais        String?
  destinatarios String?
  horarioInicio String? @map("horario_inicio")
  horarioFim    String? @map("horario_fim")
  ativo         Boolean    @default(true)
  createdAt     DateTime   @default(now()) @map("created_at")
  cliente  Cliente?  @relation(fields: [clienteId], references: [id])
  terminal Terminal? @relation(fields: [terminalId], references: [id])
  @@map("alertas_config")
}
model AlertaLog {
  id            Int          @id @default(autoincrement())
  liberacaoId   Int @map("liberacao_id")
  veiculoId     Int? @map("veiculo_id")
  tipoAlerta    TipoAlerta @map("tipo_alerta")
  canal         String
  destinatario  String
  diasRestantes Int? @map("dias_restantes")
  placaVeiculo  String? @map("placa_veiculo")
  mensagem      String
  status        StatusAlerta @default(PENDENTE)
  enviadoEm     DateTime     @default(now()) @map("enviado_em")
  liberacao Liberacao @relation(fields: [liberacaoId], references: [id])
  veiculo   Veiculo?  @relation(fields: [veiculoId], references: [id])
  @@index([liberacaoId])
  @@index([enviadoEm])
  @@map("alertas_log")
}
model AuditoriaLog {
  id             Int           @id @default(autoincrement())
  usuarioId      Int @map("usuario_id")
  tabelaAfetada  String @map("tabela_afetada")
  registroId     Int @map("registro_id")
  acao           AcaoAuditoria
  dadosAntigos   String? @map("dados_antigos")
  dadosNovos     String? @map("dados_novos")
  // Nomes dos campos alterados (separados por vírgula) — facilita filtro/resumo sem parsear o JSON.
  camposAlterados String? @map("campos_alterados")
  // Identificação legível do registro no momento da alteração (placa, instrução, nome...) —
  // continua valendo mesmo depois que o registro é excluído.
  descricao      String?
  // Liberação a que o registro pertence (a própria, ou a do veículo) — agrupa o histórico da carga.
  liberacaoId    Int?    @map("liberacao_id")
  ip             String?
  rota           String?
  createdAt      DateTime      @default(now()) @map("created_at")
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  @@index([tabelaAfetada])
  @@index([tabelaAfetada, registroId])
  @@index([liberacaoId])
  @@index([usuarioId])
  @@index([createdAt])
  @@map("auditoria_log")
}
