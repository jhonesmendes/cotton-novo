# Copie para ".env" na raiz e ajuste os valores.
# Lido automaticamente pelo Docker Compose (docker-compose.yml / docker-compose.prod.yml).

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cotton_db

# ─── Autenticação ───────────────────────────────────────────────────────────
JWT_SECRET=troque-por-uma-chave-secreta-forte-min-32-chars
JWT_EXPIRES_IN=1h
# Prazo até precisar logar de novo (sessão renova sozinha até vencer este
# prazo, silenciosamente) — mantenha curto em contas compartilhadas por
# várias pessoas, pra não deixar sessão "esquecida" aberta por dias.
JWT_REFRESH_EXPIRES_IN=12h
ENCRYPTION_KEY=troque-por-uma-chave-de-32-caracteres

# ─── Produção (docker-compose.prod.yml) ─────────────────────────────────────
# URL pública do frontend, usada pelo backend para CORS e nos links dos
# emails (ex: redefinição de senha).
FRONTEND_URL=https://seu-dominio.com

# ─── SMTP (recuperação de senha por email) ──────────────────────────────────
# Sem SMTP_HOST configurado, o backend só loga no console em vez de enviar.
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@seudominio.com
SMTP_PASS=troque-pela-senha-ou-app-password
SMTP_FROM="Cotton Fibra Forte <no-reply@seudominio.com>"

# ─── Portas expostas no host (opcional, têm defaults sensatos) ─────────────
# POSTGRES_PORT=5432
# ADMINER_PORT=8080
# BACKEND_PORT=3001
# FRONTEND_PORT=5173
