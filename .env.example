# Copie para ".env" na raiz e ajuste os valores.
# Lido automaticamente pelo Docker Compose (docker-compose.yml / docker-compose.prod.yml).

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cotton_db

# ─── Autenticação ───────────────────────────────────────────────────────────
JWT_SECRET=troque-por-uma-chave-secreta-forte-min-32-chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=troque-por-uma-chave-de-32-caracteres

# ─── Produção (docker-compose.prod.yml) ─────────────────────────────────────
# URL pública do frontend, usada pelo backend para CORS.
FRONTEND_URL=https://seu-dominio.com

# ─── Portas expostas no host (opcional, têm defaults sensatos) ─────────────
# POSTGRES_PORT=5432
# ADMINER_PORT=8080
# BACKEND_PORT=3001
# FRONTEND_PORT=5173
